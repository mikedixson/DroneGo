# Docker Environment Configuration
# Copy this to .env when running with Docker Compose

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (Docker container)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dronego
DB_USER=dronego
DB_PASSWORD=dronego_dev_password
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Data Sync Endpoints
CAA_DATA_ENDPOINT=https://example.com/caa-data
NATS_DATA_ENDPOINT=https://example.com/nats-data
NOTAM_DATA_ENDPOINT=https://example.com/notam-data
DATA_SYNC_INTERVAL=86400000
