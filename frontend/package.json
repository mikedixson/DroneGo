{
  "name": "dronego-frontend",
  "version": "1.0.0",
  "description": "DroneGo Flight Zone Map - Frontend PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "drone",
    "aviation",
    "map",
    "pwa"
  ],
  "author": "DroneGo",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@turf/turf": "^6.5.0",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.1",
    "@types/leaflet": "^1.9.8",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-pwa": "^0.17.5",
    "vitest": "^1.2.2",
    "workbox-window": "^7.0.0"
  }
}
