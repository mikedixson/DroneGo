# Frontend Environment Variables
# Copy this file to .env and configure your settings

# API Base URL (leave empty to use proxy in development)
# PRODUCTION: Must use HTTPS for geolocation API (NFR-004)
VITE_API_BASE_URL=/api/v1

# HTTPS Configuration (required for browser geolocation API)
# Development: Vite generates self-signed certificate automatically
# Production: Configure proper SSL/TLS certificates via hosting provider
